# Copy to .env (never commit .env). settings.py reads this file; real environment variables take precedence.

# A long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver


AI_SERVICE_API_KEY=change-this-to-a-long-random-key-of-32-or-more-chars
CHATBOT_MODEL_PATH=trained_models/chatbot_nlp.joblib
CHAT_MEMORY_RETENTION_DAYS=30
